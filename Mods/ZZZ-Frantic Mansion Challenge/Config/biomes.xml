<configs>
       
	<!-- Remove all surface biome decorations -->
	<remove xpath="/worldgeneration/biomes/biome//decorations/decoration"/>
  
	<set xpath="//biome[@name='wasteland']//layers//layer[@blockname='terrDestroyedStone,terrDestroyedGrass,terrDestroyedGrass']/@blockname">terrWastelandGround</set>
	<set xpath="//biome[@name='wasteland']//layers//layer[@blockname='terrDestroyedStone,terrDestroyedGrass']/@blockname">terrWastelandGround</set>
	<set xpath="//biome[@name='wasteland']//layers//layer[@blockname='terrDestroyedGrass']/@blockname">terrWastelandGround</set>
	<setattribute xpath="//biome[@name='wasteland']" name="topsoil_block">terrWastelandGround</setattribute>
	
	<set xpath="//biome[@name='pine_forest']//layers//layer[@blockname='terrForestGround']/@blockname">terrACForestGround</set>
	<setattribute xpath="//biome[@name='pine_forest']" name="topsoil_block">terrACForestGround</setattribute>
	
	<set xpath="//biome[@name='burnt_forest']//layers//layer[@blockname='terrBurntForestGround']/@blockname">terrACBurntForestGround</set>
	<setattribute xpath="//biome[@name='burnt_forest']" name="topsoil_block">terrACBurntForestGround</setattribute>
	
	<set xpath="//biome[@name='desert']//layers//layer[@blockname='terrDesertGround']/@blockname">terrACDesertGround</set>
	<setattribute xpath="//biome[@name='desert']" name="topsoil_block">terrACDesertGround</setattribute>
	
	<set xpath="//biome[@name='snow']//layers//layer[@blockname='terrSnow']/@blockname">terrACSnow</set>
	<setattribute xpath="//biome[@name='snow']" name="topsoil_block">terrACSnow</setattribute>

	<setattribute xpath="/worldgeneration/biomes/biome[@name='burnt_forest']" name="gamestage_modifier">0.5</setattribute>
	<setattribute xpath="/worldgeneration/biomes/biome[@name='burnt_forest']" name="gamestage_bonus">5</setattribute>
	<setattribute xpath="/worldgeneration/biomes/biome[@name='desert']" name="gamestage_modifier">1</setattribute>
	<setattribute xpath="/worldgeneration/biomes/biome[@name='desert']" name="gamestage_bonus">10</setattribute>
	<setattribute xpath="/worldgeneration/biomes/biome[@name='snow']" name="gamestage_modifier">1.5</setattribute>
	<setattribute xpath="/worldgeneration/biomes/biome[@name='snow']" name="gamestage_bonus">20</setattribute>
	<setattribute xpath="/worldgeneration/biomes/biome[@name='wasteland']" name="gamestage_modifier">2</setattribute>
	<setattribute xpath="/worldgeneration/biomes/biome[@name='wasteland']" name="gamestage_bonus">30</setattribute>

</configs>